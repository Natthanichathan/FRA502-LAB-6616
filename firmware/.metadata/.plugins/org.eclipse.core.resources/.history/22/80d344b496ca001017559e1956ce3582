// Calculate pos and velo from encoder
void QEIEncoderPosVel_Update()
{
	// collect data
	QEIdata.TimeStamp[NEW] = micros();
	QEIdata.Position[NEW] = __HAL_TIM_GET_COUNTER(&htim3);

	// Position 1 turn calculation
	QEIdata.QEIPostion_1turn = QEIdata.Position[NEW] % 3072;

	// calculate dx
	int32_t diffPosition = QEIdata.Position[NEW] - QEIdata.Position[OLD];

	// Handle Warp around
	if (diffPosition > (65535 / 2))
		diffPosition -= 65535;
	else if (diffPosition < -(65535 / 2))
		diffPosition += 65535;

	// calculate dt
	float diffTime = (QEIdata.TimeStamp[NEW] - QEIdata.TimeStamp[OLD]) * 0.000001;

	// calculate anglar velocity
	QEIdata.QEIAngularVelocity = (float) diffPosition / diffTime / 3072.0 * 2 * M_PI;

	// store value for next loop
	QEIdata.Position[OLD] = QEIdata.Position[NEW];
	QEIdata.TimeStamp[OLD] = QEIdata.TimeStamp[NEW];
}

void QEI_for_ROS_Update()
{
	// collect data
	QEI_ROS.TimeStamp[NEW] = QEIdata.TimeStamp[NEW];
	QEI_ROS.Position[NEW] = QEIdata.Position[NEW];

	// Position 1 turn calculation
	QEI_ROS.QEIPostion_1turn = QEIdata.QEIPostion_1turn;

	// calculate dx
	int32_t diffPosition = QEI_ROS.Position[NEW] - QEI_ROS.Position[OLD];

	// Handle Warp around
	if (diffPosition > (65535 / 2))
		diffPosition -= 65535;
	else if (diffPosition < -(65535 / 2))
		diffPosition += 65535;

	// calculate dt
	float diffTime = (QEI_ROS.TimeStamp[NEW] - QEI_ROS.TimeStamp[OLD]) * 0.000001;

	// calculate anglar velocity
	QEI_ROS.QEIAngularVelocity = (float) diffPosition / diffTime / 3072.0 * 2 * M_PI;

	// store value for next loop
	QEI_ROS.Position[OLD] = QEI_ROS.Position[NEW];
	QEI_ROS.TimeStamp[OLD] = QEI_ROS.TimeStamp[NEW];
}


